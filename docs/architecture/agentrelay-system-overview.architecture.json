  "cards": [
    {
      "dot": "emerald",
      "title": "Entry points",
      "items": [
        "Browsers and ChatGPT/Codex reach the Site through Sites sign-in",
        "Token agents go through the local client, which adds the Agent Token and the Site's gateway token",
        "HTTP and both MCP endpoints call the same owner-scoped operations"
      ]
    },
    {
      "dot": "rose",
      "title": "Invariants",
      "items": [
        "Every query filters by ownerId, resolved only in src/server/auth",
        "State changes are version-guarded (CAS, 409 on conflict)",
        "Prompts, receipts and images are inert data, never executed"
      ]
    },
    {
      "dot": "violet",
      "title": "Storage",
      "items": [
        "D1 holds handoffs, devices, projects, tokens, attachment rows and subscriptions",
        "R2 holds original image bytes; object keys never leave the server",
        "Expired handoffs and orphaned images are swept on later workspace use"
      ]
    }
  ]
