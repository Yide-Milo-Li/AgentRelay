  "cards": [
    { "dot": "emerald", "title": "Entry points", "items": ["Each build has one sign-in gate: the Sites gate on a Site, Cloudflare Access with Google on a standalone Worker", "Token agents go through the local client; only a Site also needs its gateway token, because Access lets /api/agent/* through", "HTTP and both MCP endpoints call the same owner-scoped operations"] },
    { "dot": "cyan", "title": "Build targets", "items": ["AGENTRELAY_TARGET (sites or cloudflare) is fixed at build time and picks one identity source", "A cloudflare build fails if its output still reads the Sites headers", "The Worker verifies Access tokens itself (RS256, team keys, AUD); missing settings answer 503"] },
    { "dot": "rose", "title": "Invariants", "items": ["Every query filters by ownerId, resolved only in src/server/auth", "State changes are version-guarded (CAS, 409 on conflict)", "Prompts, receipts and images are inert data, never executed"] },
    { "dot": "violet", "title": "Storage", "items": ["D1 holds handoffs, devices, projects, tokens, attachment rows and subscriptions", "R2 holds original image bytes; object keys never leave the server", "The inbox polls paged summaries; only the detail view reads a prompt"] }
  ]
